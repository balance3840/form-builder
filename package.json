{
  "name": "@restrella/form-builder",
  "version": "0.2.5",
  "type": "module",
  "description": "Visual builder for @restrella/form-generator forms. Standalone app, or embed it with mountFormBuilder().",
  "homepage": "https://balance3840.github.io/form-builder/",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:playground": "tsc --noEmit && vite build --base /form-builder/playground-app/ --outDir website/static/playground-app --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "build:lib": "tsc --noEmit && vite build --config vite.lib.config.ts && cp types/index.d.ts dist-lib/index.d.ts",
    "watch:lib": "vite build --config vite.lib.config.ts --watch"
  },
  "devDependencies": {
    "@monaco-editor/loader": "1.4.0",
    "@preact/preset-vite": "^2.9.0",
    "@preact/signals": "^1.3.0",
    "@restrella/form-generator": "file:../form-generator",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "lucide": "1.48.0",
    "preact": "^10.24.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "main": "dist-lib/form-builder.js",
  "module": "dist-lib/form-builder.js",
  "types": "dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/form-builder.js",
      "default": "./dist-lib/form-builder.js"
    }
  },
  "files": [
    "dist-lib/"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@restrella/form-generator": ">=2.0.0-alpha.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/balance3840/form-builder"
  }
}
